# ---------------------------------------------------------------------------
# PhotoSite Manager
#
# Copy to .env.local. With NO values set at all the app runs in fully local
# mode: JSON-file database, local file site host, password login below.
# ---------------------------------------------------------------------------

# --- Auth ------------------------------------------------------------------
# Used in local mode. In supabase mode, Supabase Auth is used instead.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# Any long random string. Signs the session cookie.
SESSION_SECRET=dev-secret-change-me-to-something-long-and-random

# --- Data backend ----------------------------------------------------------
# "local" (JSON files under .data/) or "supabase"
DATA_BACKEND=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site host -------------------------------------------------------------
# "local" (writes to .data/published, served at /host/<project>) or "cloudflare"
SITE_HOST=local
CLOUDFLARE_ACCOUNT_ID=
# Needs: Pages:Edit. Add Zone:Read + DNS:Edit only when you start managing zones.
CLOUDFLARE_API_TOKEN=

# --- Domains ---------------------------------------------------------------
# Nameservers shown to clients for delegated-NS mode. Cloudflare assigns these
# per-account; read them off your first zone in the Cloudflare dashboard.
EXPECTED_NAMESERVERS=

# --- Not wired up yet (Stripe is a later phase) ----------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
